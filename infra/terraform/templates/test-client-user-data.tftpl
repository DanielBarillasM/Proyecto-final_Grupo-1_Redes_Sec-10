#!/bin/bash
# =============================================================================
# user_data - Cliente temporal de pruebas: ${role} (${client_ip})
# Generado por Terraform (infra/terraform/test-clients.tf). No editar en la instancia.
# Responsable: Genser Catalán
# =============================================================================
set -euo pipefail
exec > >(tee -a /var/log/rednova-test-client-setup.log) 2>&1
echo "[$(date -Is)] Inicio de configuración del cliente de ${role}"

# Herramientas versionadas: consulta DNS sin bind-utils y hardening común.
install -d -o root -g root -m 0750 /opt/rednova
echo '${dnsquery_b64}' | base64 -d > /usr/local/bin/rednova-dnsquery
chmod 0755 /usr/local/bin/rednova-dnsquery
echo '${hardening_b64}' | base64 -d > /opt/rednova/hardening.sh
chmod 0750 /opt/rednova/hardening.sh

%{ if wait_for_internet ~}
# Visitas: la IPv4 pública temporal permite la salida a Internet. Se espera la
# salida antes de consultar los repositorios de Amazon Linux 2023.
for intento in $(seq 1 30); do
  if curl -s -m 5 -o /dev/null https://aws.amazon.com/; then
    echo "Salida a Internet disponible (intento $intento)"
    break
  fi
  echo "Sin salida a Internet todavía (intento $intento); reintento en 10 s"
  sleep 10
done
%{ endif ~}

# Ambos clientes deben tener firewall del sistema operativo. Visitas obtiene el
# paquete por Internet y TI mediante el Gateway Endpoint privado de S3.
for intento in 1 2 3; do
  dnf -y install nftables && break
  echo "dnf falló (intento $intento); reintento en 15 s"
  sleep 15
done
rpm -q nftables
command -v nft >/dev/null
%{ if configure_internal_dns ~}
# TI espera a que BIND9 responda antes de cambiar la resolución del sistema.
dns_listo=0
for intento in $(seq 1 30); do
  if /usr/local/bin/rednova-dnsquery "rrhh.${internal_domain}" "${dns_ip}" --timeout 3 2>/dev/null | grep -q "${intranet_ip}"; then
    dns_listo=1
    break
  fi
  echo "DNS interno no disponible (intento $intento); reintento en 10 s"
  sleep 10
done
[ "$dns_listo" -eq 1 ] || { echo "ERROR: BIND9 no respondió con ${intranet_ip}" >&2; exit 1; }

# Se intenta split DNS con systemd-resolved. AL2023 puede operar con el stub
# deshabilitado, por lo que se comprueba getent y se fija BIND9 como primer
# resolvedor si el nombre interno todavía no se resuelve.
install -d -m 0755 /etc/systemd/resolved.conf.d
printf '[Resolve]\nDNS=${dns_ip}\nDomains=~${internal_domain} ~0.10.10.in-addr.arpa\n' \
  > /etc/systemd/resolved.conf.d/rednova-internal.conf
if systemctl list-unit-files --type=service | grep -q '^systemd-resolved.service'; then
  systemctl restart systemd-resolved
fi
if ! getent ahostsv4 "rrhh.${internal_domain}" | awk '{print $1}' | grep -qx "${intranet_ip}"; then
  cp -L /etc/resolv.conf /etc/resolv.conf.rednova.bak
  rm -f /etc/resolv.conf
  {
    echo "nameserver ${dns_ip}"
    grep -v "^nameserver ${dns_ip}$" /etc/resolv.conf.rednova.bak
  } > /etc/resolv.conf
  chmod 0644 /etc/resolv.conf
fi
getent ahostsv4 "rrhh.${internal_domain}" | awk '{print $1}' | grep -qx "${intranet_ip}"
%{ endif ~}

# Hardening común (SSH por llave, sysctl, servicios y nftables con SSH solo
# desde Administración). Un fallo impide declarar listo al cliente.
/opt/rednova/hardening.sh
systemctl is-enabled nftables >/dev/null
nft list table inet rednova >/dev/null

# Inventario de arranque: el cliente no debe escuchar en otro puerto que no sea SSH.
ip -4 -brief addr || true
ss -lntu || true
echo "[$(date -Is)] Cliente de ${role} listo"
